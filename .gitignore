# Provider binary
terraform-provider-verify

# Terraform state and lock files
*.tfstate
*.tfstate.*
*.tfstate.old
*.tfstate.backup*
.terraform/
.terraform.lock.hcl

# certificates/ directory — contains the key pair generated by examples/cert/
# The entire directory is excluded so neither the private key nor the
# certificate is ever accidentally committed.
examples/certificates/

# Go build cache
*.exe
*.test

#terraform tfvars
*.tfvars
*.tfvars.json

# keys for my project
keys.txt
