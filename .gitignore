# macOS metadata — never commit
.DS_Store
**/.DS_Store

# Bob AI assistant artifacts — never commit
.bob/

# Provider binary
terraform-provider-verify

# Terraform runtime files — never commit (state, lock, local cache, credentials)
*.tfstate
*.tfstate.*
*.tfstate.old
*.tfstate.backup*
.terraform/
.terraform.lock.hcl

# Terraform variable files — contain real credentials, never commit
*.tfvars
*.tfvars.json

# certificates/ directory — contains the key pair generated by examples/cert/
# The entire directory is excluded so neither the private key nor the
# certificate is ever accidentally committed.
examples/certificates/

# Go build cache
*.exe
*.test

# keys for my project
keys.txt

# VS Code workspace settings
.vscode/
